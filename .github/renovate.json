{
  "extends": [
    "config:base",
    ":automergeBranch",
    ":automergeDigest",
    ":automergeMinor",
    ":automergeRequireAllStatusChecks",
    ":dependencyDashboard",
    ":disablePeerDependencies",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":label(dependencies)",
    ":pinAllExceptPeerDependencies",
    ":timezone(Europe/Lisbon)",
    "schedule:earlyMondays"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "gulp",
        "gulp-cli"
      ],
      "groupName": "gulp tooling"
    }
  ],
  "enabledManagers": [
    "npm"
  ],
  "postUpdateOptions": [
    "yarnDedupeHighest"
  ]
}
